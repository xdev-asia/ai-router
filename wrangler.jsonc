{
  "name": "xdev-llm",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-15",
  // enable_request_signal: request.signal fires when the client goes away, so the gateway ends the provider request
  // too (worker/timeouts.ts). It is the default only from the 2026-11-17 compatibility date.
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xdev-llm",
      "database_id": "4ea47bf1-1a83-4beb-a993-a99cef4e9241",
      "migrations_dir": "migrations"
    }
  ],
  // The owner console (web/, built into dist/). The API paths reach the Worker first.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/admin/*", "/anthropic/*", "/openai/*", "/auth/*", "/health", "/api/health", "/v1", "/v1/*", "/v1beta/*", "/skills", "/skills/*", "/mcp", "/mcp/*", "/studio/*"]
  },
  // Other Workers can also reach the gateway through a service binding.
  "routes": [{ "pattern": "ai-router.xdev.asia", "custom_domain": true }],
  "vars": {
    "ANTHROPIC_BASE_URL": "https://api.anthropic.com",
    // Console sign-in with xDev ID. OIDC_CLIENT_ID comes from `node scripts/admin.mjs oauth-client` in services/id.
    "OIDC_ISSUER": "https://id.xdev.asia/api/auth",
    "OIDC_CLIENT_ID": "oGUOHBDqyjeFZQNvCIkfqbWTFXwqSLWY",
    "CONSOLE_EMAILS": "tdduy.dev@gmail.com"
  },
  // Secrets (wrangler secret put): ANTHROPIC_KEYS, ADMIN_TOKEN_SHA256, OIDC_CLIENT_SECRET, CONNECTIONS_KEY. See README.
  "observability": { "enabled": true }
}
