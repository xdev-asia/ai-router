# For running the studio on its own (corepack pnpm run dev). In ai-router's compose these come from the
# compose file and the secrets volume. Never commit .env.

# ai-router: its address and the gateway token of a system made for the studio (console, #/systems).
AI_ROUTER_URL=http://localhost:8787
AI_ROUTER_TOKEN=

# Every /api call needs Authorization: Bearer <secret>. STUDIO_SECRET, else the file STUDIO_SECRET_FILE names.
STUDIO_SECRET=
# STUDIO_SECRET_FILE=/secrets/studio-secret

# Seals channel credentials: openssl rand -base64 32. Changing it makes stored channels unreadable.
CHANNELS_KEY=

# Where the internet reaches /files/<id>.mp4 and .jpg (Instagram fetches the clip from there; Zalo links it).
PUBLIC_BASE_URL=

# PORT=8791
# STUDIO_DATA_DIR=./data
# SUBTITLE_FONT=DejaVu Sans
